# ── Dataset (never commit raw data) ─────────────────────────────────────
data/raw/creditcard.csv
data/raw/*.csv
data/processed/*.csv

# ── Python ────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
*.egg-info/
dist/
build/

# ── Jupyter ───────────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints

# ── Generated artifacts (large files; committed selectively) ──────────────
# Score files are small enough to commit (each ~1 MB); keep them
# results/scores/

# Large model files — commit only when small (< 100 MB)
results/models/*.joblib
results/models/*.pkl

# ── OS / IDE ──────────────────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
